# Domain served by Caddy (enables automatic HTTPS in production; use localhost for local compose tests)
WEBIDE_DOMAIN=ide.example.com

# Comma-separated allowed public hostnames in bridge.mjs (add apex + www if both resolve)
WEBIDE_PUBLIC_HOSTS=ide.example.com

# Optional extra CORS origins (comma-separated)
WEBIDE_ORIGINS=

# Per-IP rate limits (no authentication required)
WEBIDE_RL_PAGE=120
WEBIDE_RL_SESSION=20
WEBIDE_RL_PROXY=60
WEBIDE_RL_DL=15
WEBIDE_RL_DL_MB=500

# Set 1 on staging/private hosts to disallow all crawlers and send noindex
WEBIDE_NOINDEX=
